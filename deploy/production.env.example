# Example for the future production host. Supply real values outside Git.
# The application reads these from its process environment, or an explicit
# -env-file path. Do not use the development server's .env or database.
APP_ENV=production
APP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://APP_USER:CHANGE_ME@DB_HOST:5432/ttwms?sslmode=verify-full&sslrootcert=/etc/ttwms/database-ca.crt
